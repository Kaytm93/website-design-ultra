{
  "schemaVersion": 1,
  "surface": "wdu.interaction-checkpoints",
  "project": "keyboard-fail",
  "modeInput": "WDU_DETERMINISTIC=1",
  "readyMarker": "html[data-wdu-ready=\"true\"]",
  "checkpoints": [
    {
      "id": "hero-hover-before",
      "interaction": "hover",
      "group": "hero-hover",
      "phase": "before",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-ready=\"true\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-hover-during",
      "interaction": "hover",
      "group": "hero-hover",
      "phase": "during",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-pointer=\"hover\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-hover-after",
      "interaction": "hover",
      "group": "hero-hover",
      "phase": "after",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-pointer=\"idle\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-click-before",
      "interaction": "click",
      "group": "hero-click",
      "phase": "before",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-ready=\"true\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-click-peak",
      "interaction": "click",
      "group": "hero-click",
      "phase": "peak",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-pointer=\"pressed\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-click-recovered",
      "interaction": "click",
      "group": "hero-click",
      "phase": "recovered",
      "target": ".scene-frame",
      "waitFor": "html[data-wdu-pointer=\"idle\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "page-scroll-0",
      "interaction": "scroll",
      "progress": 0
    },
    {
      "id": "page-scroll-50",
      "interaction": "scroll",
      "progress": 0.5
    },
    {
      "id": "page-scroll-100",
      "interaction": "scroll",
      "progress": 1
    },
    {
      "id": "scene-ready",
      "interaction": "ready",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "scene-failure",
      "interaction": "failure",
      "action": "lose-webgl-context",
      "waitFor": "html[data-wdu-context=\"lost\"]",
      "scrollIntoView": ".scene-frame"
    },
    {
      "id": "hero-focus-before",
      "interaction": "focus",
      "group": "hero-focus",
      "phase": "before",
      "target": "[data-wdu-activation-target]",
      "waitFor": "html[data-wdu-ready=\"true\"]",
      "scrollIntoView": "[data-wdu-activation-target]"
    },
    {
      "id": "hero-focus-during",
      "interaction": "focus",
      "group": "hero-focus",
      "phase": "during",
      "target": "[data-wdu-activation-target]",
      "waitFor": "[data-wdu-activation-target]:focus-visible",
      "scrollIntoView": "[data-wdu-activation-target]"
    },
    {
      "id": "hero-focus-after",
      "interaction": "focus",
      "group": "hero-focus",
      "phase": "after",
      "target": "[data-wdu-activation-target]",
      "waitFor": "html[data-wdu-focus=\"none\"]",
      "scrollIntoView": "[data-wdu-activation-target]"
    },
    {
      "id": "hero-keyboard-before",
      "interaction": "keyboard",
      "group": "hero-keyboard",
      "phase": "before",
      "target": "#never-focusable",
      "waitFor": "html[data-wdu-ready=\"true\"]",
      "scrollIntoView": "#never-focusable"
    },
    {
      "id": "hero-keyboard-peak",
      "interaction": "keyboard",
      "group": "hero-keyboard",
      "phase": "peak",
      "target": "#never-focusable",
      "waitFor": "html[data-wdu-pointer=\"pressed\"]",
      "scrollIntoView": "#never-focusable"
    },
    {
      "id": "hero-keyboard-recovered",
      "interaction": "keyboard",
      "group": "hero-keyboard",
      "phase": "recovered",
      "target": "#never-focusable",
      "waitFor": "html[data-wdu-pointer=\"idle\"]",
      "scrollIntoView": "#never-focusable"
    },
    {
      "id": "hero-touch-before",
      "interaction": "touch",
      "group": "hero-touch",
      "phase": "before",
      "target": "[data-wdu-activation-target]",
      "waitFor": "html[data-wdu-ready=\"true\"]",
      "scrollIntoView": "[data-wdu-activation-target]"
    },
    {
      "id": "hero-touch-peak",
      "interaction": "touch",
      "group": "hero-touch",
      "phase": "peak",
      "target": "[data-wdu-activation-target]",
      "waitFor": "html[data-wdu-pointer=\"pressed\"]",
      "scrollIntoView": "[data-wdu-activation-target]"
    },
    {
      "id": "hero-touch-recovered",
      "interaction": "touch",
      "group": "hero-touch",
      "phase": "recovered",
      "target": "[data-wdu-activation-target]",
      "waitFor": "html[data-wdu-pointer=\"idle\"]",
      "scrollIntoView": "[data-wdu-activation-target]"
    }
  ]
}
