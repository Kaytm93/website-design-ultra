          },
          {
            "value": 33,
            "unit": "ms"
          },
          {
            "value": 32,
            "unit": "ms"
          }
        ],
        "median": {
          "value": 32,
          "unit": "ms"
        },
        "p95": {
          "value": 33,
          "unit": "ms"
        }
      },
      "firstMeaningfulFrame": {
        "marker": "html[data-wdu-ready=\"true\"]",
        "observed": {
          "value": 1180,
          "unit": "ms"
        }
      },
      "transfer": {
