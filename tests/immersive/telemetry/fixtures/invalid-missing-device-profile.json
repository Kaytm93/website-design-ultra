{
  "schemaVersion": 1,
  "surface": "wdu.immersive-telemetry",
  "budget": {
    "frameTarget": {
      "rate": {
        "value": 30,
        "unit": "fps"
      },
      "frameTime": {
        "value": 33,
        "unit": "ms"
      },
      "justification": "The declared mid-range desktop target is 30 fps; 33 ms is an explicit project ceiling for this fixture rather than a threshold inferred from the rate."
    },
    "gates": [
      {
        "class": "warm-gpu-frame-time",
        "comparison": "less-than-or-equal",
        "targets": {
          "median": {
            "value": 33,
            "unit": "ms"
          },
          "p95": {
            "value": 33,
            "unit": "ms"
          }
        },
        "warmup": {
          "value": 120,
          "unit": "frames"
        },
        "sampleWindow": {
          "value": 300,
          "unit": "frames"
        },
        "justification": "The warm GPU window excludes the declared 120-frame shader and asset warm-up and evaluates 300 measured frames."
      },
      {
        "class": "first-meaningful-frame",
        "comparison": "less-than-or-equal",
        "marker": "html[data-wdu-ready=\"true\"]",
        "target": {
          "value": 1500,
          "unit": "ms"
        },
        "justification": "The project declares the stable-frame marker as the first meaningful frame and budgets its arrival at 1.5 seconds."
      },
      {
        "class": "transfer-before-first-meaningful-frame",
        "comparison": "less-than-or-equal",
        "boundary": "first-meaningful-frame",
        "target": {
          "value": 524288,
          "unit": "bytes"
        },
        "justification": "Only bytes completed before the first meaningful-frame marker belong to this boundary."
      }
    ]
  },
  "runtime": {
    "frame": {
      "warmGpu": {
        "samples": [
