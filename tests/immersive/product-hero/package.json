{
  "name": "wdu-product-hero",
  "version": "0.1.0",
  "private": true,
  "description": "website-design-ultra immersive evaluation fixture (IP-07A): an R3F product hero that installs, builds, and loads offline with one optimized model, semantic DOM, portrait reframe, poster, reduced motion, and the shared quality/telemetry surfaces.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "model:generate": "node scripts/generate-product-model.mjs",
    "model:pipeline": "node scripts/build-model.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:fixture": "node scripts/verify-fixture.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.1",
    "meshoptimizer": "1.2.0",
    "typescript": "5.9.3"
  }
}
