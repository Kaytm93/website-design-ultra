{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wdu://cinematic-timeline/v1",
  "title": "Cinematic timeline manifest",
  "description": "Normalized cinematic timeline coordinating DOM, camera, scene, material, sound, and loading tracks without a second clock (IP-09C, T2.4). Every track has exactly one owner and one property; two writers for one property are rejected. Normalized range is [0,1], masterSource is the injected SceneClock. Portrait choreography is separate when required. Checkpoint ids feed PR-6 capture directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surface", "project", "modeInput", "clock", "range", "tracks", "checkpoints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surface": { "const": "wdu.cinematic-timeline" },
    "project": { "type": "string", "minLength": 1 },
    "modeInput": { "const": "WDU_DETERMINISTIC=1" },
    "clock": { "const": "injected" },
    "range": {
      "type": "array",
      "prefixItems": [{ "const": 0 }, { "const": 1 }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "portrait": { "$ref": "#/$defs/portrait" },
    "requiresPortrait": { "const": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "progress"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress", "value"],
      "properties": {
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "value": { "type": "number" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "property", "owner", "keyframes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["dom", "camera", "scene", "material", "sound", "loading"] },
        "property": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$" },
        "owner": { "type": "string", "minLength": 1 },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/keyframe" }
        }
      }
    },
    "portrait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracks"],
      "properties": {
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/track" }
        },
        "checkpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkpoint" }
        }
      }
    }
  }
}
